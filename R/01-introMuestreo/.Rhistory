geom_hline(yintercept = mean(EfectoDosis$Flavonoides),
color = "gray50", linetype = "dashed", linewidth = 0.8) +
stat_summary(fun = mean, geom = "point",
shape = 23, size = 2.5, fill = "darkgreen", color = "white") +
scale_fill_manual(values = pal_trat) +
labs(title = "Flavonoides por tratamiento (T1–T12)",
subtitle = "Línea discontinua = media global · Rombo = media por grupo",
x = "Tratamiento", y = "Flavonoides (mg/g)") +
tema_taller +
theme(legend.position = "none",
axis.text.x = element_text(angle = 45, hjust = 1))
p_box_trat
