mat_cor <- EfectoDosis %>%
select(Dosis, Repetición, Flavonoides) %>%
cor(use = "complete.obs") %>%
as.data.frame() %>%
rownames_to_column("var1") %>%
pivot_longer(-var1, names_to = "var2", values_to = "r")
p_heatmap <- ggplot(mat_cor, aes(x = var1, y = var2, fill = r)) +
geom_tile(color = "white", linewidth = 0.8) +
geom_text(aes(label = sprintf("%.2f", r),
color = abs(r) > 0.6), size = 4.5, fontface = "bold") +
scale_color_manual(values = c(`TRUE` = "white", `FALSE` = "black"),
guide = "none") +
scale_fill_gradient2(low = "#3B7DD8", mid = "white", high = "#D94A4A",
midpoint = 0, limits = c(-1, 1),
name = "r") +
labs(title = "Matriz de correlación (Pearson)",
x = NULL, y = NULL) +
coord_fixed() +
tema_taller +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
p_heatmap
modelo <- lm(Flavonoides ~ Dosis * CS, data = EfectoDosis)
EfectoDosis_diag <- EfectoDosis %>%
mutate(
fit     = fitted(modelo),
res     = residuals(modelo),
res_std = rstandard(modelo)
)
x_grid <- seq(min(EfectoDosis_diag$res), max(EfectoDosis_diag$res),
length.out = 200)
p_res_fit <- ggplot(EfectoDosis_diag, aes(x = fit, y = res, color = CS)) +
geom_hline(yintercept = 0, color = "darkred",
linetype = "dashed", linewidth = 0.9) +
geom_point(size = 2.5, alpha = 0.9) +
geom_smooth(method = "loess", se = FALSE, color = "darkgreen",
linewidth = 1, linetype = "solid") +
scale_color_manual(values = pal_cs) +
labs(title = "Residuos vs Ajustados",
subtitle = "Verde = suavizado LOWESS · Rojo = cero",
x = "Valores ajustados", y = "Residuos") +
tema_taller
p_res_fit
sw_res <- shapiro.test(EfectoDosis_diag$res)
p_qq_res <- ggplot(EfectoDosis_diag, aes(sample = res)) +
stat_qq(shape = 21, size = 2.5, fill = "steelblue", color = "gray20") +
stat_qq_line(color = "darkred", linewidth = 1) +
labs(title = "QQ-plot de residuos",
subtitle = sprintf("Shapiro-Wilk residuos: p = %.4f", sw_res$p.value),
x = "Cuantiles teóricos", y = "Residuos estandarizados") +
tema_taller
p_qq_res
p_hist_res <- ggplot(EfectoDosis_diag, aes(x = res)) +
geom_histogram(aes(y = after_stat(density)),
bins = 10, fill = "lightsteelblue",
color = "white", alpha = 0.9) +
stat_function(fun = dnorm,
args = list(mean = mean(EfectoDosis_diag$res),
sd   = sd(EfectoDosis_diag$res)),
color = "darkred", linewidth = 1.1) +
labs(title = "Distribución de residuos vs normal teórica",
x = "Residuos", y = "Densidad") +
tema_taller
p_hist_res
p_scale_loc <- ggplot(EfectoDosis_diag,
aes(x = fit, y = sqrt(abs(res_std)))) +
geom_point(aes(color = CS), size = 2, alpha = 0.85) +
geom_hline(yintercept = mean(sqrt(abs(EfectoDosis_diag$res_std))),
color = "red", linetype = "dashed") +
scale_color_manual(values = pal_cs) +
labs(title = "Scale-Location",
x = "Ajustados", y = expression(sqrt("|residuos est.|"))) +
tema_taller
p_scale_loc
