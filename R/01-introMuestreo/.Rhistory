k_sturges <- ceiling(log2(nrow(EfectoDosis)) + 1)
p_hist <- ggplot(EfectoDosis, aes(x = Flavonoides)) +
geom_histogram(aes(y = after_stat(density)),
bins   = k_sturges,
fill   = "steelblue",
color  = "white",
alpha  = 0.85) +
geom_density(color = "darkred", linewidth = 1.1) +
geom_vline(aes(xintercept = mean(Flavonoides)),
color = "darkgreen", linetype = "dashed", linewidth = 1) +
geom_vline(aes(xintercept = median(Flavonoides)),
color = "orange", linetype = "dotted", linewidth = 1) +
geom_vline(xintercept = quantile(EfectoDosis$Flavonoides, c(0.25, 0.75)),
color = "gray40", linetype = "dotdash", linewidth = 0.7) +
labs(
title    = "Distribución del contenido de flavonoides",
subtitle = sprintf("n = %d · clases (Sturges) = %d",
nrow(EfectoDosis), k_sturges),
x = "Flavonoides (mg/g)", y = "Densidad"
) +
tema_taller
p_hist
p_box_global <- ggplot(EfectoDosis, aes(x = Flavonoides, y = "")) +
geom_boxplot(fill = "lightcoral", color = "gray20",
width = 0.4, outlier.color = "red", outlier.shape = 1) +
geom_jitter(height = 0.08, width = 0, size = 1.5,
alpha = 0.6, color = "gray20") +
stat_summary(fun = mean, geom = "point",
shape = 23, size = 3, fill = "darkgreen", color = "white") +
labs(title = "Boxplot global de flavonoides",
x = "Flavonoides (mg/g)", y = NULL) +
tema_taller
p_box_global
sw_global <- shapiro.test(EfectoDosis$Flavonoides)
p_qq_global <- ggplot(EfectoDosis, aes(sample = Flavonoides)) +
stat_qq(shape = 21, size = 2.5, fill = "steelblue", color = "gray20") +
stat_qq_line(color = "darkred", linewidth = 1) +
labs(title = "QQ-plot: normalidad de flavonoides",
subtitle = sprintf("Shapiro-Wilk: W = %.3f, p = %.4f",
sw_global$statistic, sw_global$p.value),
x = "Cuantiles teóricos (normal)",
y = "Cuantiles observados") +
tema_taller
p_qq_global
p_box_trat <- ggplot(EfectoDosis,
